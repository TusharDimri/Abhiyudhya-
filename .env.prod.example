# Production settings for docker-compose.prod.yml. On the server:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod && nano .env.prod
# Replace every <...>. .env.prod is gitignored - never commit it.

FLASK_ENV=production

# Two different random values. Make each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start while either still says change-me.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# RDS: the master user and password, the endpoint from the RDS console, and the
# initial database name. Use a password of letters and digits only - symbols
# such as @ / : would break this line. sslmode=require encrypts the connection.
DATABASE_URL=postgresql+psycopg2://<db-user>:<db-password>@<rds-endpoint>:5432/<db-name>?sslmode=require
# Connections each API worker keeps open (defaults 10 + 20 are too many for db.t4g.micro)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Redis runs as a container beside the API
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_PREFIX=abhiyudhya

# The address people type, with https:// and no slash at the end
CORS_ORIGINS=https://<domain>

# S3 in Mumbai. Leave the four blank settings blank: the EC2 server's IAM role
# signs the upload and download links, so no keys are stored here.
S3_BUCKET=<bucket-name>
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

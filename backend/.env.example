# Copy to .env and fill in. The real .env is gitignored (spec Part 7.5).

# --- Flask ---
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-dev-secret
JWT_SECRET_KEY=change-me-dev-jwt-secret

# --- Database (matches docker-compose.local.yml postgres service) ---
DATABASE_URL=postgresql+psycopg2://rnaf:rnaf@postgres:5432/rnaf

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- S3 / MinIO (local object storage) ---
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=rnaf-media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- CORS (frontend dev server) ---
CORS_ORIGINS=http://localhost:5173
